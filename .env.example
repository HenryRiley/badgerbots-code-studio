# Local development only. Copy to .env.local; never commit real credentials.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://badgerbots:badgerbots@localhost:5432/badgerbots
SESSION_COOKIE_SECURE=false
LOG_LEVEL=debug

# Hosted pilot provider values. Keep placeholders for local bootstrap.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-admin-only-key
RESEND_API_KEY=replace-with-local-email-key

# Owner bootstrap command. Use protected environment settings and a temporary password file;
# never put the password or service-role key in shell history or source control.
BB_SUPABASE_URL=http://127.0.0.1:54321
BB_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-admin-only-key
BB_BOOTSTRAP_EMAIL=owner@example.invalid
BB_BOOTSTRAP_PASSWORD_FILE=/absolute/path/to/temporary-password.secret
BB_BOOTSTRAP_ORGANIZATION=BadgerBots
BB_BOOTSTRAP_LOCATION=Local Development

# Generate unique local values; production values belong in the deployment secret store.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
CONTROL_PLANE_SECRET_PEPPER=replace-with-at-least-32-random-bytes
HOST_PAIRING_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Optional in Checkpoint 0. Email delivery is not required for local bootstrap.
EMAIL_PROVIDER=console
EMAIL_FROM=local@invalid.example
