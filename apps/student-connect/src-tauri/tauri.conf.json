{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BadgerBots Connect",
  "version": "0.1.0",
  "identifier": "org.badgerbots.studio.connect",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "BadgerBots Connect",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BadgerBots",
    "copyright": "Copyright © 2026 BadgerBots",
    "category": "Education",
    "shortDescription": "Connect a managed student laptop to BadgerBots Code Studio.",
    "longDescription": "BadgerBots Connect manages a stable device identity and a dedicated Minecraft launcher profile for in-person camps.",
    "icon": [
      "../../host-windows/src-tauri/icons/32x32.png",
      "../../host-windows/src-tauri/icons/128x128.png",
      "../../host-windows/src-tauri/icons/128x128@2x.png",
      "../../host-windows/src-tauri/icons/icon.icns",
      "../../host-windows/src-tauri/icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
